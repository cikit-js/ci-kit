{
  "name": "@ci-kit/changelog",
  "type": "module",
  "version": "0.5.2",
  "description": "Turn git commits into grouped release notes",
  "author": "imba97",
  "license": "MIT",
  "homepage": "https://github.com/cikit-js/ci-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cikit-js/ci-kit.git"
  },
  "bugs": {
    "url": "https://github.com/cikit-js/ci-kit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "ci-kit-changelog": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "stub": "unbuild --stub"
  },
  "dependencies": {
    "cac": "^7.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
